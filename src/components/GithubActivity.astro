---
import type { Locale } from '../i18n/config';
import {
  contributionsEndpoint,
  readSnapshot,
  toMonthLabels,
  toWeeks,
  type ContributionDay,
} from '../lib/contributions';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const username = 'Canqiang';

let contributions: ContributionDay[] = [];
let total = 0;
let fetchFailed = false;

try {
  const res = await fetch(contributionsEndpoint(username), {
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) {
    ({ contributions, total } = readSnapshot(await res.json()));
  } else {
    fetchFailed = true;
  }
} catch {
  fetchFailed = true;
}

const monthLocale = locale === 'en' ? 'en-US' : 'zh-CN';
const weeks = toWeeks(contributions);
const monthLabels = toMonthLabels(weeks, monthLocale);

const copy = locale === 'en'
  ? { captionPrefix: '', captionSuffix: ' contributions in the last year', less: 'Less', more: 'More' }
  : { captionPrefix: '近一年共 ', captionSuffix: ' 次代码贡献', less: '低', more: '高' };

// The build-time render is the no-JS fallback and the first paint. Because the
// site rebuilds only once a day, that snapshot is already stale by the time a
// visitor sees it — the newest cell holds a partial count captured mid-build.
// The client script below refetches on load so the grid always shows today.
const hasServerData = !fetchFailed && contributions.length > 0;
---

<div
  class="github-activity"
  data-github-activity
  data-endpoint={contributionsEndpoint(username)}
  data-month-locale={monthLocale}
  data-caption-prefix={copy.captionPrefix}
  data-caption-suffix={copy.captionSuffix}
  hidden={!hasServerData}
>
  <p class="github-activity__caption mono">
    <span data-activity-caption-prefix>{copy.captionPrefix}</span><span
      class="github-activity__count"
      data-activity-count>{total.toLocaleString(monthLocale)}</span><span
      data-activity-caption-suffix>{copy.captionSuffix}</span>
  </p>
  <div class="github-activity__scroll">
    <div
      class="github-activity__months mono"
      data-activity-months
      style={`grid-template-columns: repeat(${weeks.length}, 11px); column-gap: 3px;`}
    >
      {monthLabels.map(({ label, weekIndex }) => (
        <span style={`grid-column-start: ${weekIndex + 1}`}>{label}</span>
      ))}
    </div>
    <div class="github-activity__weeks" data-activity-weeks>
      {weeks.map((week) => (
        <div class="github-activity__week">
          {week.map((day) => (
            day ? (
              <div class="github-activity__cell" data-level={day.level} title={`${day.date}: ${day.count}`} />
            ) : (
              <div class="github-activity__cell github-activity__cell--empty" aria-hidden="true" />
            )
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="github-activity__legend mono">
    <span>{copy.less}</span>
    <div class="github-activity__cell" data-level="0"></div>
    <div class="github-activity__cell" data-level="1"></div>
    <div class="github-activity__cell" data-level="2"></div>
    <div class="github-activity__cell" data-level="3"></div>
    <div class="github-activity__cell" data-level="4"></div>
    <span>{copy.more}</span>
  </div>
</div>

<script>
  import { readSnapshot, toMonthLabels, toWeeks } from '../lib/contributions';

  const root = document.querySelector<HTMLElement>('[data-github-activity]');
  const endpoint = root?.dataset.endpoint;
  if (root && endpoint) {
    const monthsEl = root.querySelector<HTMLElement>('[data-activity-months]');
    const weeksEl = root.querySelector<HTMLElement>('[data-activity-weeks]');
    const countEl = root.querySelector<HTMLElement>('[data-activity-count]');
    const monthLocale = root.dataset.monthLocale ?? 'en-US';

    // Astro scopes every rule in this component's <style> block behind a
    // generated [data-astro-cid-*] attribute. Elements built here must carry it
    // or they match no CSS at all and collapse to zero height. The attribute
    // name is read off the root so a rebuilt hash cannot desync from it.
    const scopeAttr = root.getAttributeNames().find((name) => name.startsWith('data-astro-cid-'));
    const scoped = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (scopeAttr) node.setAttribute(scopeAttr, '');
      return node;
    };

    const render = (payload: unknown) => {
      const { contributions, total } = readSnapshot(payload);
      if (contributions.length === 0 || !monthsEl || !weeksEl || !countEl) return;

      const weeks = toWeeks(contributions);
      countEl.textContent = total.toLocaleString(monthLocale);

      monthsEl.style.gridTemplateColumns = `repeat(${weeks.length}, 11px)`;
      monthsEl.replaceChildren(
        ...toMonthLabels(weeks, monthLocale).map(({ label, weekIndex }) => {
          const span = scoped('span');
          span.textContent = label;
          span.style.gridColumnStart = String(weekIndex + 1);
          return span;
        }),
      );

      weeksEl.replaceChildren(
        ...weeks.map((week) => {
          const column = scoped('div', 'github-activity__week');
          for (const day of week) {
            const cell = scoped('div', 'github-activity__cell');
            if (day) {
              cell.dataset.level = String(day.level);
              cell.title = `${day.date}: ${day.count}`;
            } else {
              cell.classList.add('github-activity__cell--empty');
              cell.setAttribute('aria-hidden', 'true');
            }
            column.append(cell);
          }
          return column;
        }),
      );

      root.hidden = false;
    };

    fetch(endpoint, { signal: AbortSignal.timeout(8000) })
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then(render)
      .catch(() => {
        // Keep whatever the build-time render produced.
      });
  }
</script>

<style>
  .github-activity {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .github-activity[hidden] {
    display: none;
  }

  .github-activity__caption {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .github-activity__count {
    color: var(--accent);
    font-weight: 600;
  }

  .github-activity__scroll {
    overflow-x: auto;
    max-width: 100%;
    min-width: 0;
    padding-bottom: 0.5rem;
  }

  .github-activity__months {
    display: grid;
    min-width: max-content;
    margin-bottom: 0.35rem;
  }

  .github-activity__months span {
    color: var(--text-dim);
    font-size: 0.66rem;
  }

  .github-activity__weeks {
    display: flex;
    gap: 3px;
    min-width: max-content;
  }

  .github-activity__week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .github-activity__cell {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: var(--rule);
  }

  .github-activity__cell--empty {
    visibility: hidden;
  }

  .github-activity__cell[data-level="1"] { background: color-mix(in srgb, var(--accent) 30%, var(--bg-raised)); }
  .github-activity__cell[data-level="2"] { background: color-mix(in srgb, var(--accent) 55%, var(--bg-raised)); }
  .github-activity__cell[data-level="3"] { background: color-mix(in srgb, var(--accent) 78%, var(--bg-raised)); }
  .github-activity__cell[data-level="4"] { background: var(--accent); }

  .github-activity__legend {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.66rem;
  }

  .github-activity__legend .github-activity__cell {
    width: 11px;
    height: 11px;
  }
</style>
