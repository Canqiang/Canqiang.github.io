---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  locale: Locale;
}

type Project = CollectionEntry<'projects'>;
type ProjectCategory = Project['data']['category'];

const { locale } = Astro.props;
const taxonomy: Array<{ key: ProjectCategory; en: string; zh: string }> = [
  { key: 'open-source', en: 'Open Source', zh: '开源' },
  { key: 'applied-ai', en: 'LLM Systems', zh: '大模型系统' },
  { key: 'medical-ai', en: 'Medical AI', zh: '医疗 AI' },
  { key: 'research', en: 'Research', zh: '研究' },
  { key: 'competitions', en: 'Competitions', zh: '竞赛' },
];
const projects = (await getCollection('projects', ({ data }) => data.locale === locale && !data.draft))
  .sort((left, right) => (
    left.data.order - right.data.order ||
    left.data.translationKey.localeCompare(right.data.translationKey)
  ));
const copy = locale === 'en'
  ? {
      title: 'Selected projects',
      summary: 'Open-source agent infrastructure, LLM systems, computer vision, research, and competition modeling.',
    }
  : {
      title: '精选项目',
      summary: '开源智能体基础设施、大模型系统、计算机视觉、研究与竞赛建模。',
    };
---

<header class="project-index-intro shell">
  <h1 class="display">{copy.title}</h1>
  <p>{copy.summary}</p>
</header>

<div class="project-index shell">
  {taxonomy.map((category) => {
    const entries = projects.filter((project) => project.data.category === category.key);
    if (entries.length === 0) return null;

    return (
      <div id={`project-category-${category.key}`} class="project-index__cards">
        {entries.map((project) => (
          <ProjectCard
            {project}
            heading="h2"
            categoryLabel={category[locale]}
            url={localizedPath(locale, 'project', project.data.translationKey)}
          />
        ))}
      </div>
    );
  })}
</div>
