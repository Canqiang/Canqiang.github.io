---
import workstation from '../assets/nes-workstation.png';
import { identity } from '../data/site';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'en'
  ? {
      name: identity.name, projects: 'View projects', systemsButton: 'AI Systems Résumé',
      more: 'Also', algorithms: 'Reasoning, Eval & ML résumé', competitions: 'Competitions',
    }
  : {
      name: `${identity.chineseName} / ${identity.name}`, projects: '查看项目', systemsButton: 'AI 系统简历',
      more: '更多', algorithms: '推理、评测与算法简历', competitions: '竞赛记录',
    };
---

<section class="nes-hero shell" aria-labelledby="hero-title">
  <div class="nes-hero__copy">
    <p class="nes-hero__identity">
      <span class="nes-hero__beacon" aria-hidden="true"></span>
      {copy.name} <span class="nes-hero__divider" aria-hidden="true">/</span> {identity.role[locale]}
    </p>
    <h1 class="nes-hero__title" id="hero-title">{identity.headline[locale]}</h1>
    <p class="nes-hero__intro">{identity.introduction[locale]}</p>
    <div class="nes-hero__actions">
      <a class="nes-button nes-button--primary" href={localizedPath(locale, 'projects')}>
        <span class="nes-button__cursor" aria-hidden="true"></span>{copy.projects}
      </a>
      <a class="nes-button" href={localizedPath(locale, 'resume')}>{copy.systemsButton}</a>
    </div>
    <p class="nes-hero__resumes">
      <span>{copy.more}</span>
      <a href={localizedPath(locale, 'resume-algorithms')}>{copy.algorithms}</a>
      <a href={localizedPath(locale, 'project', 'competitions')}>{copy.competitions}</a>
    </p>
  </div>
  <div class="nes-hero__art" aria-hidden="true">
    <img
      src={workstation.src}
      width={workstation.width}
      height={workstation.height}
      alt=""
      decoding="async"
    />
  </div>
</section>

<style>
  .nes-hero {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
  }

  .nes-hero__copy { min-width: 0; }

  .nes-hero__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.4rem;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .nes-hero__beacon {
    width: 0.75rem;
    height: 0.75rem;
    background: currentColor;
    clip-path: polygon(25% 0, 75% 0, 75% 25%, 100% 25%, 100% 75%, 75% 75%, 75% 100%, 25% 100%, 25% 75%, 0 75%, 0 25%, 25% 25%);
  }

  .nes-hero__divider { color: var(--text-dim); }

  .nes-hero__title {
    margin: 0;
    max-width: 100%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 4.6vw, 3.75rem);
    font-weight: 400;
    line-height: 1.055;
    white-space: pre-line;
  }

  :global(html[lang^='zh']) .nes-hero__title {
    line-height: 1.22;
  }

  .nes-hero__intro {
    max-width: 58ch;
    margin: 1.2rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.65;
  }

  .nes-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block: 1.65rem 1rem;
  }

  .nes-button {
    display: inline-flex;
    min-height: 2.75rem;
    gap: 0.65rem;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 1rem;
    border: 2px solid var(--text);
    background: var(--bg-raised);
    box-shadow: 3px 3px 0 var(--rule);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .nes-button--primary {
    border-color: var(--accent);
    color: var(--bg);
    background: var(--accent);
  }

  .nes-button:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--rule); }
  .nes-button:active { transform: translate(2px, 2px); box-shadow: none; }

  .nes-button__cursor {
    width: 0.55rem;
    height: 0.65rem;
    background: currentColor;
    clip-path: polygon(0 0, 33% 0, 33% 20%, 67% 20%, 67% 40%, 100% 40%, 100% 60%, 67% 60%, 67% 80%, 33% 80%, 33% 100%, 0 100%);
  }

  .nes-hero__resumes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.85rem;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .nes-hero__resumes a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
  }
  .nes-hero__resumes a:hover { color: var(--accent); }

  .nes-hero__art {
    position: relative;
    width: 100%;
    max-width: 33rem;
    justify-self: center;
    padding: 5px;
    border: 2px solid var(--text-muted);
    background: #11172d;
    box-shadow: 5px 5px 0 var(--rule);
  }

  .nes-hero__art img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  @media screen and (max-width: 41.999rem) {
    .nes-hero {
      gap: 0;
      padding-block: 1.5rem 2rem;
    }
    .nes-hero__copy { display: contents; }
    .nes-hero__identity { margin-bottom: 0.75rem; }
    .nes-hero__actions { gap: 0.6rem; margin-block: 1.1rem 0.15rem; }
    .nes-button { padding-inline: 0.7rem; font-size: 1rem; }
    .nes-hero__art { order: 1; margin-top: 0.65rem; }
    .nes-hero__intro { order: 2; margin-top: 1rem; }
  }

  @media (min-width: 42rem) {
    .nes-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .nes-hero__art { justify-self: end; }
  }

  @media print {
    .nes-hero { display: block; padding-block: 1rem; }
    .nes-hero__art, .nes-hero__actions, .nes-hero__resumes { display: none; }
  }
</style>
