---
import { fieldCards } from '../data/site';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// The collection follows career chronology; show current work first on the homepage.
const recentFirst = fieldCards.toReversed();
const present = locale === 'en' ? 'present' : '至今';
---

<ul class="field-cards">
  {recentFirst.map((card) => (
    <li class="field-card" data-field={card.key}>
      <a class="field-card__link" href={localizedPath(locale, 'project', card.project)}>
        <span class="field-card__icon" aria-hidden="true"></span>
        <span class="field-card__name">{card.name[locale]}</span>
        <span class="field-card__scope">{card.scope[locale]}</span>
        <span class="field-card__meta">{card.startYear}–{card.endYear ?? present} · {card.orgs[locale]}</span>
        <span class="field-card__destination">{card.projectLabel[locale]} <span aria-hidden="true">→</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .field-cards {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .field-card { min-width: 0; }
  .field-card__link {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1rem, 2vw, 1.4rem);
    background: var(--bg-raised);
    border: 2px solid var(--rule);
    box-shadow: 3px 3px var(--shadow);
    text-decoration: none;
  }
  .field-card__link:hover,
  .field-card__link:focus-visible { border-color: var(--cyan); }
  .field-card__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 0.375rem;
    background: url('../assets/field-icons.png') 0 0 / 192px 48px no-repeat;
    image-rendering: pixelated;
  }
  [data-field="medical-ai"] .field-card__icon { background-position-x: -48px; }
  [data-field="llm-products"] .field-card__icon { background-position-x: -96px; }
  [data-field="agent-systems"] .field-card__icon { background-position-x: -144px; }
  .field-card__name { font: 400 1.5rem/1.15 var(--font-display); color: var(--text); }
  .field-card__scope { color: var(--text-muted); font-size: 0.95rem; }
  .field-card__meta { margin-block: 0.35rem; color: var(--text-dim); font-size: 0.8rem; }
  .field-card__destination {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
    color: var(--cyan);
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (max-width: 37.99rem) {
    .field-card__link {
      grid-template: "icon title" auto "icon summary" auto "icon meta" auto "icon destination" auto / 36px minmax(0, 1fr);
      column-gap: 0.875rem;
      row-gap: 0.25rem;
    }
    .field-card__icon { grid-area: icon; transform: scale(0.75); transform-origin: top left; }
    .field-card__name { grid-area: title; }
    .field-card__scope { grid-area: summary; }
    .field-card__meta { grid-area: meta; }
    .field-card__destination { grid-area: destination; }
  }
  @media (min-width: 38rem) { .field-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 56rem) { .field-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
