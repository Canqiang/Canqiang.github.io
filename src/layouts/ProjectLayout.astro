---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { data } = project;
const locale: Locale = data.locale;
const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const pathname = localizedPath(locale, 'project', data.translationKey);
// Link to the three in-depth cases. Astro assigns each translated heading its own slug.
const caseLinks = data.translationKey === 'competitions'
  ? [
      { label: 'NeuroGolf', term: 'NeuroGolf' },
      { label: 'Orbit Wars', term: 'Orbit Wars' },
      { label: 'AIMO3', term: 'Progress Prize 3' },
    ].flatMap(({ label, term }) => {
      const heading = headings.find(({ depth, text }) => depth === 3 && text.includes(term));
      return heading ? [{ label, heading }] : [];
    })
  : [];
const copy = locale === 'en'
  ? {
      titleSuffix: 'Xander Xu',
      back: 'All projects',
      switchLanguage: '阅读中文版',
      switchAria: `Read ${data.title} in Chinese`,
      status: 'Open source',
      role: 'Role',
      period: 'Period',
      technology: 'Technology index',
      links: 'Public links',
      cases: 'Competition writeups',
      navigation: 'Project navigation',
    }
  : {
      titleSuffix: '许灿强',
      back: '全部项目',
      switchLanguage: 'Read in English',
      switchAria: `阅读 ${data.title} 的英文版`,
      status: '开源',
      role: '角色',
      period: '时间',
      technology: '技术索引',
      links: '公开链接',
      cases: '竞赛复盘',
      navigation: '项目导航',
    };
---

<BaseLayout
  {locale}
  title={`${data.title} — ${copy.titleSuffix}`}
  description={data.summary}
  {pathname}
  image={data.ogImage}
>
  <article class="project-detail shell">
    <nav class="project-detail__navigation no-print" aria-label={copy.navigation}>
      <a href={localizedPath(locale, 'projects')}>← {copy.back}</a>
      <a
        href={localizedPath(otherLocale, 'project', data.translationKey)}
        hreflang={otherLocale === 'en' ? 'en' : 'zh-CN'}
        aria-label={copy.switchAria}
      >
        <span lang={otherLocale === 'en' ? 'en' : 'zh-CN'}>{copy.switchLanguage}</span> →
      </a>
    </nav>

    <header class="project-detail__header">
      <div class="project-detail__heading">
        {data.translationKey === 'core-ai' && <p class="project-detail__status">{copy.status}</p>}
        <h1>{data.title}</h1>
        <p class="project-detail__summary">{data.summary}</p>
        {caseLinks.length > 0 && (
          <nav class="case-menu no-print" aria-labelledby="case-menu-title">
            <p id="case-menu-title">{copy.cases}</p>
            <ul>
              {caseLinks.map(({ label, heading }) => (
                <li><a href={`#${heading.slug}`} title={heading.text}>{label}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </div>
      <dl class="project-detail__facts">
        <div>
          <dt>{copy.role}</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>{copy.period}</dt>
          <dd>{data.period}</dd>
        </div>
      </dl>
    </header>

    {data.technologies.length > 0 && (
      <section class="project-detail__technology" aria-labelledby="project-technology-title">
        <h2 id="project-technology-title">{copy.technology}</h2>
        <ul>
          {data.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </section>
    )}

    {data.links.length > 0 && (
      <nav class="project-detail__links" aria-labelledby="project-links-title">
        <h2 id="project-links-title">{copy.links}</h2>
        <ul>
          {data.links.map((link) => <li><a href={link.href}>{link.label} ↗</a></li>)}
        </ul>
      </nav>
    )}

    <div class="project-detail__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .case-menu {
    margin-top: 1.35rem;
  }

  .case-menu p {
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .case-menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-menu a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.625rem;
    border: 2px solid var(--rule);
    box-shadow: 2px 2px var(--shadow);
    color: var(--cyan);
    background: var(--bg-raised);
    font: 400 1rem/1.25 var(--font-display);
    text-decoration: none;
  }

  .case-menu a:hover,
  .case-menu a:focus-visible { border-color: var(--cyan); }

  .case-menu a:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }
</style>
